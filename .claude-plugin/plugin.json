{
  "name": "rm-plugin-v2",
  "description": "Reach Machine plugin v2 (in development). Steps 1-5: connection check, choose workspace, whose account, your Instagram account, how you make money.",
  "version": "2.0.0",
  "author": {
    "name": "Reach Machine"
  },
  "mcpServers": {
    "reachmachine": {
      "type": "http",
      "url": "https://api.reachmachine.org/mcp/?client=rm-plugin"
    },
    "apify": {
      "type": "http",
      "url": "https://mcp.apify.com?tools=call-actor&telemetry-enabled=true",
      "timeout": 600000
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.79",
        "--headless",
        "--isolated"
      ]
    }
  }
}
