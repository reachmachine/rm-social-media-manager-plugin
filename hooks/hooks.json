          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/customer-upload-gate.sh\""
          }
        ]
      },
      {
        "matcher": "WebSearch|mcp__plugin_rm-plugin-v2_(reachmachine|apify|playwright)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/job-budget-gate.sh\""
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/niche-search-budget.sh\""
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hangouts-websearch-gate.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/connection-reminder.sh\""
