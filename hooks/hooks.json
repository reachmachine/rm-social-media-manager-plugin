{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/reset-connections.sh\""
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-rules.sh\""
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/reset-connections.sh\""
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-rules.sh\""
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/reset-connections.sh\""
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-rules.sh\""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-rules.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_rm-plugin-v2_(reachmachine|apify|playwright)__(get_billing_status|get-actor-run|browser_navigate|record_session_start|list_workspaces|create_workspace|set_active_workspace|open_workspace|get_creator_brief|update_creator_brief|record_session_event|get_resume_checklist|record_checklist_step|add_to_watchlist|refresh_competitor|change_own_account|start_website_read|finish_website_read|wait_for_website_read|browser_evaluate|get_website_read_status|save_business_fact|search_business_knowledge|get_next_fact_task|get_fact_tasks|save_business_facts|start_reviews_fetch|finish_reviews_fetch|call-actor|get-dataset-items|get_business_review|answer_business_review|start_niche_pick|save_niche_research|choose_niche|start_dream_customer|get_hangouts_work|save_dream_customer|get_dream_customer|choose_main_persona)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/record-connection-probe.sh\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/record-connection-probe.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_rm-plugin-v2_reachmachine__(start_customer_upload|send_customer_files|get_customer_upload)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/customer-file-upload.sh\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "mcp__plugin_rm-plugin-v2_reachmachine__(next_actions|open_workspace|get_resume_checklist|start_niche_pick|save_niche_research|choose_niche)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/plan-recorder.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_rm-plugin-v2_reachmachine__(get_job|report_job)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/job-tool-cache.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_rm-plugin-v2_reachmachine__answer_question",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/answer-grant-record.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_rm-plugin-v2_(reachmachine|apify|playwright)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/plan-events.sh\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/voice-check-midturn.sh\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/ask-dropped-mark.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_rm-plugin-v2_reachmachine__report_gap",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/report-pending-mark.sh\""
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hangouts-websearch-record.sh\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__plugin_rm-plugin-v2_(reachmachine|apify|playwright)__(get_billing_status|get-actor-run|browser_navigate|record_session_start)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/record-connection-probe.sh\""
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hangouts-websearch-record.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_rm-plugin-v2_(reachmachine|apify|playwright)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/connections-gate.sh\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/connections-gate.sh\""
          }
        ]
      },
      {
        "matcher": "Read|Bash|Glob",
